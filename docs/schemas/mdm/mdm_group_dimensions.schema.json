{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quatrain.dev/schemas/mdm/mdm_group_dimensions.schema.json",
  "title": "Physical Dimensions & Enclosure Specification Group Schema",
  "description": "Standard Quatrain MDM specification group for physical dimensions (metric/imperial) and ingress protection rating",
  "type": "object",
  "scope": "type",
  "required": ["unitSystem", "height", "width"],
  "properties": {
    "unitSystem": {
      "type": "string",
      "title": "Unit System",
      "enum": ["metric", "imperial"],
      "default": "metric"
    },
    "height": {
      "type": "number",
      "title": "Height (mm or inches)",
      "minimum": 0
    },
    "width": {
      "type": "number",
      "title": "Width (mm or inches)",
      "minimum": 0
    },
    "depth": {
      "type": "number",
      "title": "Depth (mm or inches)",
      "minimum": 0
    },
    "weight": {
      "type": "number",
      "title": "Weight (grams or lbs)",
      "minimum": 0
    },
    "enclosureRating": {
      "type": "string",
      "title": "Ingress Protection Rating",
      "enum": ["IP65", "IP66", "IP67", "IP68", "NONE"]
    }
  }
}
