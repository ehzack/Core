{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quatrain.dev/schemas/mdm/mdm_group_electrical.schema.json",
  "title": "Electrical Hardware Ratings Specification Group Schema (Type-Level)",
  "description": "Standard Quatrain MDM specification group for static hardware operating voltage ratings, peak amperage, and active/sleep power consumption",
  "type": "object",
  "scope": "type",
  "properties": {
    "voltageNominal": {
      "type": "number",
      "title": "Nominal Voltage (V)",
      "minimum": 0
    },
    "voltageMin": {
      "type": "number",
      "title": "Minimum Operating Voltage (V)",
      "minimum": 0
    },
    "voltageMax": {
      "type": "number",
      "title": "Maximum Operating Voltage (V)",
      "minimum": 0
    },
    "currentMax": {
      "type": "number",
      "title": "Peak Current Amperage (mA)",
      "minimum": 0
    },
    "powerActive": {
      "type": "number",
      "title": "Active Power Consumption (mW)",
      "minimum": 0
    },
    "powerSleep": {
      "type": "number",
      "title": "Sleep Standby Consumption (µW)",
      "minimum": 0
    }
  }
}
